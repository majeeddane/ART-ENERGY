# ─────────────────────────────────────────────────────────────
# ART ENERGY — environment variables
# Copy this file to .env.local and fill the values you need.
# .env.local is ignored by git.
# ─────────────────────────────────────────────────────────────

# Public site URL (used in canonical tags, sitemap, Open Graph).
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin dashboard (required) ───────────────────────────────
# Single admin password. Choose a long, unique value.
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Secret used to sign the admin session cookie (at least 32 chars).
ADMIN_SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ── Content storage ──────────────────────────────────────────
# Leave empty for local development (content/runtime.json).
# On Vercel/Netlify you MUST use a cloud Postgres database.
# Neon free tier: https://neon.tech  → copy the pooled connection string.
# Either DATABASE_URL or POSTGRES_URL is accepted.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# POSTGRES_URL=

# ── Image uploads ────────────────────────────────────────────
# Option A — Vercel Blob (recommended on Vercel)
# Create a Blob store in the Vercel dashboard and copy the token.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Option B — Cloudinary (works on Vercel/Netlify)
# Create an unsigned upload preset in Cloudinary settings.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# ── Contact form delivery (optional, in order of priority) ───
# 1) Formspree
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# 2) Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_FROM_EMAIL=ART ENERGY <hello@your-domain.com>
# CONTACT_TO_EMAIL=Waterkind0@gmail.com

# 3) Generic webhook (Zapier / Make / n8n)
# CONTACT_WEBHOOK_URL=https://hooks.example.com/xxxx

# If none are configured, the API responds with a graceful fallback
# and the visitor can send the prepared message through WhatsApp/email.
